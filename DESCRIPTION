Package: agriRank
Type: Package
Title: Design-Aware Rank-Based, Permutation and Robust Inference for Agricultural Experiments
Version: 0.14.0
Authors@R: c(
    person(given = c("Walter", "Esfrain"), family = "Pereira",
           email = "walterufpb@yahoo.com.br", role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0003-1085-0191")),
