\name{agriRank-package}
\alias{agriRank-package}
\alias{agriRank}
\title{agriRank: Design-Aware Rank-Based, Permutation and Robust Inference for Agricultural Experiments}
\description{A design-aware workflow for nonparametric, rank-based, permutation, resampling, and robust inference in agricultural experiments.}
\details{The package treats the experimental design as a first-class object. It integrates CRD, RCBD, factorial, split-plot, repeated-measures, incomplete repeated-measures, multivariate, and multi-environment workflows with effect estimates, multiplicity-aware comparisons, ggplot2 graphics, sensitivity analysis, and reproducible reports. The native incomplete repeated-measures wild-rank engine is experimental and rejects additional block strata rather than silently discarding them.}
\seealso{\code{agri_design}, \code{agri_rank}, \code{agri_repeated}, \code{incomplete_wild_rank_test}}
